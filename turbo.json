{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["FRONTEND_URL", "JWT_SECRET", "REDIS_URL", "NODE_ENV", "PORT", "LIMITE_GENERAL", "LIMITE_LOGIN", "LIMITE_PESADO", "LIMITE_REPORTES", "LOGIN_FALLOS_MAX", "LOGIN_FALLOS_VENTANA_MIN", "LOGIN_BLOQUEO_MIN", "NEXT_DIST_DIR"],
  "globalDependencies": ["**/.env.*local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "test": {
      "cache": false
    },
    "db:generate": {
      "cache": false
    }
  }
}
