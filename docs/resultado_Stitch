    // FILTERS LOGIC
    function applyFilters() {
      const query = document.getElementById('searchInput').value.trim().toLowerCase();
      const clearBtn = document.getElementById('clearSearchBtn');
      const sede = document.getElementById('sedeSelect').value;
      const estado = document.getElementById('estadoSelect').value;

      if (query.length > 0) {
        clearBtn.classList.remove('hidden');
      } else {
        clearBtn.classList.add('hidden');
      }

      if (currentTab === 'clientes') {
        const filtered = CLIENTES.filter(c => {
          const matchSearch = c.nombre.toLowerCase().includes(query) ||
            c.documento.toLowerCase().includes(query) ||
            c.email.toLowerCase().includes(query) ||
            c.telefono.includes(query);

          const matchSede = sede === 'ALL' || c.sedeBase === sede;

          let matchEstado = true;
          if (estado === 'ACTIVO') matchEstado = c.estadoMembresia === 'Al día';
          else if (estado === 'VENCIDO') matchEstado = c.estadoMembresia === 'Vencido';
          else if (estado === 'SIN_MEMB') matchEstado = c.estadoMembresia === 'Sin Membresía';
          else if (estado === 'PAUSA') matchEstado = false; // ningún cliente sin membresía está pausado directamente

          return matchSearch && matchSede && matchEstado;
        });
        renderClientes(filtered);
      } 
      else if (currentTab === 'membresias') {
        const filtered = MEMBRESIAS.filter(m => {
          const matchSearch = m.clienteNombre.toLowerCase().includes(query) ||
            m.clienteDocumento.toLowerCase().includes(query) ||
            m.planNombre.toLowerCase().includes(query) ||
            m.id.toLowerCase().includes(query);

          const matchSede = sede === 'ALL' || m.sede === sede;

          let matchEstado = true;
          if (estado === 'ACTIVO') matchEstado = m.estado === 'ACTIVA';
          else if (estado === 'VENCIDO') matchEstado = m.estado === 'VENCIDA';
          else if (estado === 'PAUSA') matchEstado = m.estado === 'PAUSADA';
          else if (estado === 'SIN_MEMB') matchEstado = false;

          return matchSearch && matchSede && matchEstado;
        });
        renderMembresias(filtered);
      } 
      else if (currentTab === 'planes') {
        const filtered = PLANES.filter(p => {
          const matchSearch = p.nombre.toLowerCase().includes(query) ||
            p.descripcion.toLowerCase().includes(query);

          let matchEstado = true;
          if (estado === 'ACTIVO') matchEstado = p.estado === 'Activo';
          else if (estado === 'VENCIDO' || estado === 'SIN_MEMB') matchEstado = p.estado === 'Descontinuado';

          return matchSearch && matchEstado;
        });
        renderPlanes(filtered);
      }
    }

    function clearSearch() {
      document.getElementById('searchInput').value = '';
      applyFilters();
    }

    function resetFilters() {
      document.getElementById('searchInput').value = '';
      document.getElementById('sedeSelect').value = 'ALL';
      document.getElementById('estadoSelect').value = 'ALL';
      applyFilters();
      triggerToast('Filtros restablecidos correctamente');
    }

