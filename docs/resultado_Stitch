            </span>
            <div class="flex items-center space-x-1">
              <button onclick="triggerToast('Editando parámetros del plan ${p.nombre}')" class="px-2.5 py-1 text-xs font-medium text-slate-700 hover:text-indigo-600 hover:bg-slate-100 rounded-md transition-colors">
                Editar
              </button>
              <button onclick="triggerToast('Estado de ${p.nombre} modificado')" class="p-1 text-slate-400 hover:text-rose-600 rounded-md transition-colors" title="Activar/Desactivar">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M18.364 18.364A9 9 0 005.636 5.636m12.728 12.728A9 9 0 015.636 5.636m12.728 12.728L5.636 5.636"/>
                </svg>
              </button>
            </div>
          </div>
        </div>
      `).join('');

      // 2. Table
      const tbody = document.getElementById('planesTableBody');
      tbody.innerHTML = data.map(p => `
        <tr class="hover:bg-slate-50/80 transition-colors">
          <td class="py-3 px-4">
            <div class="font-semibold text-slate-900">${p.nombre}</div>
            <div class="text-[11px] text-slate-500 line-clamp-1 max-w-xs">${p.descripcion}</div>
          </td>
          <td class="py-3 px-4">
            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[11px] font-medium border ${
              p.tipoPlan === 'Por Tiempo / Ilimitado' ? 'bg-indigo-50 text-indigo-700 border-indigo-200' : 'bg-amber-50 text-amber-700 border-amber-200'
            }">
              ${p.tipoPlan}
            </span>
          </td>
          <td class="py-3 px-4 font-medium text-slate-700">${p.vigenciaCupos}</td>
          <td class="py-3 px-4 font-mono font-bold text-slate-900 text-sm">${p.precio}</td>
          <td class="py-3 px-4 text-slate-600">${p.restriccionHoraria}</td>
          <td class="py-3 px-4">
            <span class="px-2 py-0.5 text-[10px] font-bold rounded-md ${
              p.estado === 'Activo' ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-slate-100 text-slate-500 border border-slate-200'
            }">
              ${p.estado}
            </span>
          </td>
          <td class="py-3 px-4 text-right">
            <button onclick="triggerToast('Editando condiciones de: ${p.nombre}')" class="px-2.5 py-1 text-xs text-indigo-700 bg-indigo-50 hover:bg-indigo-100 rounded-md font-medium border border-indigo-100">
              Editar Condiciones
            </button>
          </td>
        </tr>
      `).join('');
    }

    // DRAWER / SHEET COMPONENT
    function openClientSheet(clienteId) {
      const c = CLIENTES.find(item => item.id === clienteId) || CLIENTES[0];
      
      document.getElementById('sheetClientId').textContent = c.id;
      document.getElementById('sheetName').textContent = c.nombre;
      document.getElementById('sheetDoc').textContent = c.documento;
      document.getElementById('sheetEmail').textContent = c.email;
      document.getElementById('sheetPhone').textContent = c.telefono;
      document.getElementById('sheetLastCheckin').textContent = c.ultimoAccesoFecha;
      document.getElementById('sheetBranchBadge').textContent = c.sedeBase;
      
      // Avatar
      const avatar = document.getElementById('sheetAvatar');
      avatar.className = `w-14 h-14 rounded-full flex items-center justify-center font-bold text-lg border-2 shadow-xs shrink-0 ${c.avatarColor}`;
      avatar.textContent = c.iniciales;

      // Status badge
      const statusBadge = document.getElementById('sheetStatusBadge');
      if (c.estadoMembresia === 'Al día') {
        statusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
      } else if (c.estadoMembresia === 'Vencido') {
        statusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-rose-50 text-rose-700 border border-rose-200';
      } else {
        statusBadge.className = 'inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-semibold bg-slate-100 text-slate-600 border border-slate-200';
      }
      statusBadge.textContent = c.estadoMembresia;

      // Plan Activo
      document.getElementById('sheetPlanName').textContent = c.planActual || 'Sin Plan Activo';
      const progressContainer = document.getElementById('sheetSessionProgress');
      if (c.saldoSesiones && c.totalSesiones) {
        progressContainer.innerHTML = `
          <div class="flex items-center justify-between text-xs">
            <span class="text-indigo-950 font-medium">Saldo de Sesiones:</span>
            <span class="font-bold text-indigo-700">${c.saldoSesiones} de ${c.totalSesiones} clases restantes</span>
          </div>
          <div class="w-full bg-indigo-200/50 rounded-full h-2 mt-1.5 overflow-hidden">
            <div class="bg-indigo-600 h-2 rounded-full transition-all" style="width: ${(c.saldoSesiones / c.totalSesiones) * 100}%"></div>
          </div>
        `;
      } else {
        progressContainer.innerHTML = `
          <div class="text-xs text-indigo-700 flex items-center gap-1.5">
            <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
            <span>Modalidad pase ilimitado a todas las áreas deportivas</span>
          </div>
        `;
      }

      // Historial
      document.getElementById('sheetHistoryCount').textContent = `${c.historial.length} contratos`;
      const historyList = document.getElementById('sheetHistoryList');
      historyList.innerHTML = c.historial.map(h => `
        <div class="bg-white p-3 rounded-lg border border-slate-200 shadow-2xs flex items-center justify-between text-xs">
          <div>
            <p class="font-semibold text-slate-900">${h.plan}</p>
            <p class="text-[11px] text-slate-500 mt-0.5">${h.fechas}</p>
          </div>
          <div class="text-right">
            <p class="font-mono font-bold text-slate-900">${h.monto}</p>
            <span class="inline-block text-[10px] font-medium px-1.5 rounded ${h.estado === 'Renovado' ? 'bg-emerald-50 text-emerald-700' : 'bg-slate-100 text-slate-600'}">
              ${h.estado}
            </span>
          </div>
        </div>
      `).join('');

      // Marcajes
      const logsList = document.getElementById('sheetLogsList');
      logsList.innerHTML = c.marcajes.map(m => `
        <div class="flex items-center justify-between text-xs p-2.5 rounded-lg bg-slate-50 border border-slate-100">
          <div class="flex items-center space-x-2.5">
            <div class="p-1 rounded-md bg-white border border-slate-200 text-slate-600">
              <svg class="w-3.5 h-3.5 text-indigo-600" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-slate-800">${m.fecha} - ${m.hora}</p>
              <p class="text-[10px] text-slate-400">${m.sede}</p>
            </div>
          </div>
          <span class="text-[10px] font-medium text-slate-500 bg-white px-2 py-0.5 rounded border border-slate-200">
            ${m.tipo}
          </span>
        </div>
      `).join('');

      // Open Modal
      document.getElementById('sheetModal').classList.remove('hidden');
    }

    function openMembresiaSheet(clienteId) {
      openClientSheet(clienteId);
    }

    function closeSheet() {
      document.getElementById('sheetModal').classList.add('hidden');
    }
  </script>
</body></html>