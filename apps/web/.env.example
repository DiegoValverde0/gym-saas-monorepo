# URL base de la API. Sin esta variable, el cliente HTTP (src/lib/api-client.ts)
# cae a http://localhost:3001 (dev local).
NEXT_PUBLIC_API_URL="http://localhost:3001"

# JWT_SECRET NO va en este archivo: apps/web/src/middleware.ts la necesita
# (para validar la cookie de sesión), pero se toma del .env de la raíz del
# monorepo -- ver "dev"/"build" en package.json (dotenv -e ../../.env) y el
# .env.example de la raíz. Debe ser el mismo secreto que usa la API.
