# Copiar a .env.produccion en el servidor y completar (ver docs/despliegue.md).
# Nunca subir .env.produccion al repositorio.

# Dominio que apunta al servidor (registro A del DNS). Caddy saca solo el certificado HTTPS.
DOMINIO=gym.tudominio.com

# Base de datos (solo accesible dentro de Docker).
POSTGRES_USER=gym
POSTGRES_PASSWORD=cambia-esto-por-una-clave-larga
POSTGRES_DB=gym_manager

# Secreto de las sesiones: una cadena larga y aleatoria, por ejemplo con
#   openssl rand -hex 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Superadmin de la plataforma. Solo se usa la primera vez (si no existe ninguno).
SUPERADMIN_CORREO=tu-correo@tudominio.com
SUPERADMIN_CONTRASENA=una-clave-de-12-o-mas-caracteres
SUPERADMIN_NOMBRE=Administrador de la plataforma

# Días que se guardan los respaldos diarios de la base (carpeta ./respaldos).
DIAS_RESPALDO=14
