# Docker Compose Variables
POSTGRES_USER=tu_usuario_db
POSTGRES_PASSWORD=tu_password_db
POSTGRES_DB=nombre_de_tu_db

# Application Variables
DATABASE_URL="postgresql://tu_usuario_db:tu_password_db@localhost:5433/nombre_de_tu_db?schema=public"
# Obligatoria: la API falla al arrancar si no está definida (ver auth.module.ts),
# y apps/web/src/middleware.ts también la exige para validar la cookie de sesión
# (falla cerrado, sin valor por defecto, si falta). Debe ser el mismo valor para
# ambas apps -- apps/web la toma de este mismo archivo raíz (ver package.json).
JWT_SECRET="tu_secreto_jwt_muy_seguro_y_largo"

# Orígenes permitidos por CORS en la API, separados por coma. Sin esta
# variable, cae a http://localhost:3000 (dev local). Ver apps/api/src/main.ts.
FRONTEND_URL="http://localhost:3000"

# Redis (blacklist de tokens revocados, cache de permisos RBAC, etc.). Sin esta
# variable, cae a redis://localhost:6380 (dev local, ver docker-compose.yml).
REDIS_URL="redis://localhost:6380"

# Puerto donde escucha la API. Opcional -- sin esta variable, cae a 3001.
PORT=3001
